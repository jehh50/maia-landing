# Puerto del servidor (default 3001)
PORT=3001

# Origen permitido por CORS (separa varios con coma). "*" permite todos.
CORS_ORIGIN=*

# --- PostgreSQL ---
# Connection string completa (host, puerto, db, usuario, password).
# Ejemplos:
#   postgres://maia:secret@db.example.com:5432/maia_landing
#   postgres:///maia-landing?host=/var/run/postgresql      (peer auth, Unix socket)
DATABASE_URL=postgres:///maia-landing?host=/var/run/postgresql

# Esquema donde vive la tabla `leads` (default: public)
DB_SCHEMA=public

# Forzar SSL en la conexión (proveedores como Supabase / Neon / RDS lo requieren)
PGSSL=false

# --- Nodemailer / SMTP ---
# Si SMTP_HOST está vacío, el envío se omite y solo se guarda el lead en DB.
# Algunos proveedores soportados:
#   Gmail (App Password):    smtp.gmail.com    : 465 SSL (recomendado en redes que bloquean 587)
#                                              : 587 STARTTLS (puede estar bloqueado por algunos firewalls)
#   Brevo (ex-Sendinblue):   smtp-relay.brevo.com : 587
#   Mailgun:                 smtp.mailgun.org  : 587
#   Amazon SES (us-east-1):  email-smtp.us-east-1.amazonaws.com : 587
#   Resend:                  smtp.resend.com   : 587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# From y To del correo notificador
# MAIL_FROM debe estar autorizado en tu proveedor SMTP (sender / domain verificado).
MAIL_FROM=noreply@maiabuilder.ai
MAIL_TO=maia@maiabuilder.ai

# --- Auth admin (feature 14) ---
# Secreto para firmar el JWT de sesión (HS256). En producción usa un valor largo y aleatorio
# (ej. `openssl rand -hex 48`). Si está vacío, el server genera uno al boot y avisa por log
# (las sesiones existentes se invalidan al reiniciar).
AUTH_SECRET=cambiar-en-produccion
# Para crear el primer admin manualmente:
#   node scripts/create-user.js admin@maiabuilder.ai mi-password "Admin"

# --- Admin inicial (feature 15: roles) ---
# Usados por `node scripts/seed-users.js` para crear o promover al admin
# inicial del sistema. NO los uses en producción sin rotar la contraseña.
MAIA_ADMIN_EMAIL=
MAIA_ADMIN_PASSWORD=
